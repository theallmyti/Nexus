# systemd unit for the PC Monitor agent (installed by install.sh).
[Unit]
Description=PC Monitor agent (sends this computer's hardware stats to PC Monitor)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/pc-monitor/pc-monitor-agent /etc/pc-monitor/config.toml
Restart=always
RestartSec=5
# Root is needed for the config (holds the device secret) and some sensors; nothing else.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
